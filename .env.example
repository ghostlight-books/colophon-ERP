# Server
PORT=4000
NODE_ENV=development
CLIENT_APP_URL="http://localhost:5173"
SQUARE_ENVIRONMENT="sandbox"
SQUARE_ACCESS_TOKEN=""
SQUARE_LOCATION_ID=""

# Database
DATABASE_URL="file:../packages/database/prisma/colophon.db"
CREDENTIAL_ENCRYPTION_KEY="generate-a-long-random-secret-for-production"
TENANT_BASE_DOMAIN="localhost"
ADMIN_MASTER_KEY="generate-a-long-random-admin-key-for-production"
SHOPIFY_API_KEY="your-shopify-app-client-id"
SHOPIFY_API_SECRET="your-shopify-app-client-secret"
SHOPIFY_APP_URL="https://colophon-api.onrender.com"

# Client
VITE_API_BASE_URL="http://localhost:4000/api"

# Scraper & Anti-Bot Gateway (Optional)
# Supported providers: zenrows, scrapingbee, scraperapi, crawlbase, custom
# SCRAPING_API_PROVIDER="zenrows"
# SCRAPING_API_KEY="your-scraping-api-key"
# SCRAPER_PROXY_URL="http://user:pass@proxy.residential.com:8000"
